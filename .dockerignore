.DS_Store
.git/
.runtime/
__pycache__/
*.py[cod]

# Local runtime state and downloaded models are mounted or recreated in the
# container; never send user data or model caches in the Docker build context.
agent_lab/
wav2vec2_checkpoints/
frontend/node_modules/
tests/

# Native macOS app files are not used by Docker images, except for the small
# release plist shared by macOS, local command-line runs, and containers.
macos/*
!macos/Tater/
macos/Tater/*
!macos/Tater/Resources/
macos/Tater/Resources/*
!macos/Tater/Resources/Info.plist

# Verba source now lives in the verba store; exclude local verba files from build context.
verba/*
!verba/__init__.py

# Portal source now lives in the portal store; exclude local portal files from build context.
portals/*
!portals/__init__.py

# Core source now lives in the core store; exclude local core files from build context.
cores/*
!cores/__init__.py
