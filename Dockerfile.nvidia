# Optional NVIDIA build for local STT/TTS acceleration.
# The default Dockerfile stays CPU-first; use this with docker-compose.nvidia.yml.
ARG LLAMA_CPP_REF=master
ARG LLAMA_CPP_CMAKE_ARGS=-DGGML_CUDA=on
ARG LLAMA_CPP_CUDA_BUILDER_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04

FROM ${LLAMA_CPP_CUDA_BUILDER_IMAGE} AS llama_cpp_builder

ARG LLAMA_CPP_REF
ARG LLAMA_CPP_CMAKE_ARGS

ENV TATER_LLAMA_CPP_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    cmake \
    git \
    libcurl4-openssl-dev \
    pkg-config \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git /opt/llama.cpp \
 && test -f /usr/local/cuda/lib64/stubs/libcuda.so \
 && ln -sf libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
 && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF ${LLAMA_CPP_CMAKE_ARGS} \
    -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
    -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -Wl,-rpath-link,/usr/local/cuda/lib64/stubs" \
 && cmake --build /opt/llama.cpp/build --config Release --target llama-server -j 4 \
 && test -x "$TATER_LLAMA_CPP_SERVER_BIN"

FROM python:3.11-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TATER_LLAMA_CPP_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server \
    TATER_NATIVE_SATELLITE_CREDENTIALS_PATH=/app/.runtime/native_satellite_credentials.json \
    TATER_RUNTIME_DIR=/app/.runtime \
    TATER_AIRPLAY_CLI_PATH=/usr/local/bin/cliairplay \
    TATER_FFMPEG_PATH=/usr/bin/ffmpeg \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.11/site-packages/nvidia/curand/lib:/usr/local/lib/python3.11/site-packages/nvidia/cusolver/lib:/usr/local/lib/python3.11/site-packages/nvidia/cusparse/lib:/usr/local/lib/python3.11/site-packages/nvidia/nvjitlink/lib

ARG TARGETARCH
ARG AIRPLAY_CLI_VERSION=0.4.12

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    git \
    libpq-dev \
    wget \
    ffmpeg \
    libsndfile1 \
    libgomp1 \
    libcurl4 \
    libolm-dev \
    libffi-dev \
    cmake \
    pkg-config \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Bake Tater's pinned AirPlay sender into the image so playback does not need
# an internet download after the container starts.
RUN set -eu; \
    image_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${image_arch}" in \
      amd64|x86_64) \
        asset="cliairplay-linux-x86_64"; \
        checksum="59490922adb8ac6aa3be8a1110b5472f4147fc429c3c042f986245fdb9e996ca" ;; \
      arm64|aarch64) \
        asset="cliairplay-linux-aarch64"; \
        checksum="91a5d31f0722c2b0497bbb5494f2a386dd6693ddf8ec0d24d5df00a659d7a46d" ;; \
      *) echo "Unsupported AirPlay sender architecture: ${image_arch}" >&2; exit 1 ;; \
    esac; \
    wget -q -O "${TATER_AIRPLAY_CLI_PATH}" \
      "https://github.com/music-assistant/airplay-cli/releases/download/v${AIRPLAY_CLI_VERSION}/${asset}"; \
    echo "${checksum}  ${TATER_AIRPLAY_CLI_PATH}" | sha256sum -c -; \
    chmod 0755 "${TATER_AIRPLAY_CLI_PATH}"; \
    "${TATER_AIRPLAY_CLI_PATH}" --check

COPY requirements.txt .

RUN python -m pip install --upgrade pip \
 && grep -Ev '^[[:space:]]*(torch|torchaudio|torchvision)([[:space:]=<>!~]|$)' requirements.txt > /tmp/requirements.nvidia.txt \
 && python -m pip install --index-url https://download.pytorch.org/whl/cu128 torch torchaudio \
 && python -m pip install "nvidia-cublas-cu12" "nvidia-cudnn-cu12==9.*" \
 && python -m pip install -r /tmp/requirements.nvidia.txt \
 && python -m pip uninstall -y onnxruntime \
 && python -m pip install "onnxruntime-gpu[cuda,cudnn]<1.27" \
 && python -c "from google.protobuf import runtime_version; import onnx_asr, onnxruntime as ort, torch, torchaudio, transformers, webrtcvad; providers=ort.get_available_providers(); assert 'CUDAExecutionProvider' in providers, providers; print('protobuf_runtime', runtime_version.__name__, 'torch', torch.__version__, 'cuda', torch.version.cuda, 'torchaudio', torchaudio.__version__, 'transformers', transformers.__version__, 'webrtcvad', webrtcvad.__name__, 'onnx_providers', ','.join(providers))"

COPY --from=llama_cpp_builder /opt/llama.cpp /opt/llama.cpp

RUN test -x "$TATER_LLAMA_CPP_SERVER_BIN"

COPY . .

EXPOSE 8501

ENV HTMLUI_PORT=8501

CMD ["sh", "run_ui.sh"]
